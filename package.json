{
  "name": "dsh-task-clarifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn one sentence into a precise task brief through a short guided Q&A. · 一句话变成精准任务书：左侧栏任务澄清器，少问几轮、少烧 token。",
  "icon": "icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sun-0306/dsh-task-clarifier.git"
  },
  "homepage": "https://github.com/Sun-0306/dsh-task-clarifier#readme",
  "bugs": {
    "url": "https://github.com/Sun-0306/dsh-task-clarifier/issues"
  },
  "author": "Sun <Sun-0306@users.noreply.github.com>",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin"
  ]
}
